# API base URL.
#
# DEV: keep relative — the Vite proxy forwards /api to the backend on the same
# origin, preserving HttpOnly auth cookies and the CSRF double-submit flow.
VITE_API_BASE_URL=/api/v1

# PROD (static hosting on a different origin than the API): use the backend's
# ABSOLUTE URL, e.g. in .env.production or the host's env settings:
#   VITE_API_BASE_URL=https://api-sbay.konfuse.me/api/v1
# The backend must allow the frontend origin via CORS (allow-credentials) and
# send cookies as `Secure; SameSite=None` for cross-site auth to work.
