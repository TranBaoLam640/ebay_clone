NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
SWAGGER_ENABLED=true
SWAGGER_PATH=/api-docs
MONGODB_URI=
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_DATABASE=sbay
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_AUTH_SOURCE=admin
MONGODB_REPLICA_SET=
MONGODB_TLS=false
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=1
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
CLIENT_ORIGIN=http://localhost:5173
TRUST_PROXY=1
JWT_ACCESS_SECRET=replace-with-32-or-more-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
CSRF_SECRET=replace-with-csrf-secret-32-characters
# SMTP is optional in development but required in production.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=no-reply@example.com
# Frontend page where users enter the code; the OTP is never included in this URL.
EMAIL_VERIFICATION_URL=http://localhost:5173/verify-email
PASSWORD_RESET_URL=http://localhost:5173/reset-password
# Email-verification OTP policy. Generate a unique 32+ character HMAC secret.
EMAIL_OTP_TTL_MINUTES=10
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60
EMAIL_OTP_HMAC_SECRET=replace-with-at-least-32-random-characters
LOG_LEVEL=debug
RETURN_WINDOW_DAYS=30
PAYPAL_SIMULATION_ENABLED=true

# Cloudflare R2 object storage — avatar, product image, and attachment uploads.
# Leave blank to disable uploads (the upload endpoint then returns 503).
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sbay-storage
# Public base URL for stored objects, for example an R2 custom domain.
R2_PUBLIC_URL=
UPLOAD_MAX_BYTES=5242880

# =====================================================================
# Kubernetes / production overrides (set these in the k8s ConfigMap/Secret)
# Rate limiting is enforced at ingress-nginx, NOT in the app (server is stateless).
# ---------------------------------------------------------------------
# NODE_ENV=production
# PORT=4000
# TRUST_PROXY=2                 # Cloudflare edge + ingress-nginx = 2 proxy hops (logs/cookies)
# COOKIE_SECURE=true            # TLS terminates at Cloudflare
# COOKIE_SAME_SITE=lax          # DECISION PENDING: use `none` if the frontend is a different origin than the API (then COOKIE_SECURE must be true); `lax` if same-site
# MongoDB StatefulSet (in-cluster):
# MONGODB_HOST=mongodb-0.mongodb.sbay.svc.cluster.local
# MONGODB_PORT=27017
# MONGODB_DATABASE=sbay
# MONGODB_REPLICA_SET=rs0
# MONGODB_AUTH_SOURCE=admin
# Production-strict env (env.js enforces these when NODE_ENV=production):
# EMAIL_VERIFICATION_URL=https://<prod-frontend>/verify-email   # MUST be https in production
# EMAIL_OTP_HMAC_SECRET=<real 32+ char secret>                  # placeholder is rejected in production
# CLIENT_ORIGIN=https://<prod-frontend-origin>                  # exact CORS allowlist origin(s)
# EMAIL_FROM=<real non-default sender>
# =====================================================================
