{
  "name": "sbay-user-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . && prettier --check \"src/**/*.js\" \"tests/**/*.js\" \"*.{js,json,md}\"",
    "format": "prettier --write .",
    "seed": "node src/scripts/seed.js",
    "seed:catalog": "node src/scripts/seed-catalog.js",
    "seed:coupons": "node src/scripts/seed-coupons.js",
    "seed:catalog-r2": "node src/scripts/seed-catalog-r2.js",
    "db:check": "node src/scripts/check-database.js",
    "docs:check": "node src/scripts/check-openapi.js",
    "feedback:indexes": "node src/scripts/maintain-seller-feedback-indexes.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1091.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.4",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@eslint/js": "^9.32.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.32.0",
    "globals": "^16.3.0",
    "mongodb-memory-server": "^10.1.4",
    "prettier": "^3.6.2",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
